+"""
+dispatch_guard.py -- bewaakt het starten van losgekoppelde trade-processen.
+
+NIEUW (9 sep 2026): op 9 sep bleken negen TTS-setups binnen een seconde
+te sterven op een argparse-fout in een overschreven standalone-script,
+zonder dat iemand dat zag -- geen order, geen melding, lege dag. Elk
+trade-/bewakingsproces hoort minuten tot uren te draaien; eindigt het
+binnen een paar seconden, dan is er iets grondig mis. Deze helper start
+het proces, wacht even, en stuurt bij een vroegtijdig einde een URGENTE
+melding (naar Telegram) met de laatste regels van de dispatch-log.
+"""
+import logging
+import os
+import subprocess
+
+logger = logging.getLogger(__name__)
+
+WACHT_SECONDEN = 3.0
+
+
+def _staart(log_path: str, n: int = 4) -> str:
+    try:
+        with open(log_path, encoding="utf-8", errors="ignore") as f:
+            regels = [r.rstrip() for r in f.read().splitlines() if r.strip()]
+        return "\n".join(regels[-n:])
+    except Exception:
+        return "(dispatch-log niet leesbaar)"
+
+
+def start_bewaakt(cmd: list[str], symbol: str, strategie: str, log_path: str | None = None,
+                  cwd: str | None = None) -> subprocess.Popen:
+    """
+    Start `cmd` losgekoppeld (start_new_session) met stdout/stderr naar
+    `log_path` (standaard logs/dispatch_<STRATEGIE>_<SYMBOOL>.log). Als het
+    proces binnen WACHT_SECONDEN al is geëindigd, gaat er een urgente
+    melding uit -- ongeacht de exitcode, want ook exit 0 is hier fout.
+    Geeft het Popen-object terug; gooit nooit een exception richting de
+    aanroeper (de scan moet altijd doorgaan met het volgende symbool).
+    """
+    if log_path is None:
+        log_path = f"/opt/strategy/logs/dispatch_{strategie}_{symbol}.log"
+    os.makedirs(os.path.dirname(log_path), exist_ok=True)
+    log_file = open(log_path, "a")
+    try:
+        proc = subprocess.Popen(cmd, cwd=cwd, stdout=log_file, stderr=subprocess.STDOUT,
+                                start_new_session=True)
+    except Exception as e:
+        log_file.close()
+        _urgent(f"🚨 {strategie} {symbol}: trade-proces kon NIET gestart worden -- {e}", strategie, symbol)
+        raise
+    finally:
+        pass
+    try:
+        code = proc.wait(timeout=WACHT_SECONDEN)
+    except subprocess.TimeoutExpired:
+        code = None  # draait nog: goed
+    log_file.close()
+    if code is not None:
+        _urgent(
+            f"🚨 {strategie} {symbol}: trade-proces is binnen {WACHT_SECONDEN:.0f}s gestopt "
+            f"(exitcode {code}) -- er is GEEN order geplaatst. Laatste regels uit "
+            f"{os.path.basename(log_path)}:\n{_staart(log_path)}",
+            strategie, symbol,
+        )
+    return proc
+
+
+def _urgent(tekst: str, strategie: str, symbol: str) -> None:
+    logger.error(tekst.replace("\n", " | "))
+    try:
+        from telegram_notify import send_telegram_message
+        send_telegram_message(tekst, urgent=True, strategy=strategie, symbol=symbol)
+    except Exception as e:
+        logger.error(f"Kon urgente dispatch-melding niet versturen: {e}")
