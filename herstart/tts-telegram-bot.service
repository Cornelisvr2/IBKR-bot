[Unit]
Description=Touch Turn Scalper - Telegram Bot
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/strategy
EnvironmentFile=/opt/strategy/.env
ExecStart=/usr/bin/python3 /opt/strategy/telegram_bot.py --live
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
